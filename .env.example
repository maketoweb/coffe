# Supabase (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# VAPID Push Notifications (desde tu proyecto Cloudflare)
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_BASE64
VITE_PUSH_WEBHOOK_URL=https://your-cloudflare.pages.dev/api/push-notify

# App Config
VITE_APP_NAME=FoodApp
VITE_APP_TAGLINE=Tu Restaurante Favorito
VITE_DEFAULT_THEME_COLOR=#FF6B35
VITE_APP_VERSION=2.0.0

# ─────────────────────────────────────────────────────────────────────────────
# SECRETOS (SOLO servidor). NUNCA prefijos VITE_* ni en el bundle del cliente.
# En Cloudflare Pages: Settings -> Environment variables.
# ─────────────────────────────────────────────────────────────────────────────
PUSH_WEBHOOK_SECRET=YOUR_PUSH_WEBHOOK_SECRET
# También puede ser proporcionado en la UI para el trigger de DB via app_secrets (ver migration).

# Rate limiting de los endpoints /api/* (crear un KV binding PUSH_RATE_LIMIT_KV en Cloudflare)
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000
